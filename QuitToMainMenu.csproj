<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>QuitToMainMenu</AssemblyName>
    <Version>1.0.2</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <GameDir>$(MSBuildProjectDirectory)\..\..</GameDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeTests)' == 'true'">
    <DefineConstants>$(DefineConstants);RUNTIME_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\Silverpine_Data\Managed\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(GameDir)\Silverpine_Data\Managed\UnityEngine*.dll" Private="false" />
    <Reference Include="$(GameDir)\Silverpine_Data\Managed\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\plugins\ModdingTools\ModdingTools.dll" Private="false" />
  </ItemGroup>
</Project>
